    </shape>
    <shape type="text" topLeftX="394" topLeftY="448" width="200" height="40">
      <content textType="caption" color="rgb(60,80,92)">
        <p><strong>LEB</strong> 无标签下局部校准</p>
      </content>
    </shape>
    <shape type="rect" topLeftX="646" topLeftY="436" width="256" height="54" rx="6">
