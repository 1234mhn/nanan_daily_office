      </content>
    </shape>
    <shape type="text" topLeftX="64" topLeftY="96" width="760" height="60">
      <content textType="headline" color="rgb(28,58,74)" bold="true">
        <p>图+文成对 → 已知类分清、未知类自动长出</p>
      </content>
    </shape>
    <line startX="64" startY="168" endX="896" endY="168">
      <border color="rgb(213,224,229)" width="2"/>
    </line>

    <!-- 中段：一句话说明 -->
    <shape type="rect" topLeftX="58" topLeftY="180" width="844" height="46" rx="6">
      <fill><fillColor color="rgb(233,242,242)"/></fill>
      <border color="rgb(202,224,224)" width="1"/>
