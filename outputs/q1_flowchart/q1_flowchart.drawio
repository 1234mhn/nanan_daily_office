        <mxCell id="legtxt1" value="主链计算环节" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1"><mxGeometry x="180" y="1058" width="120" height="20" as="geometry"/></mxCell>
