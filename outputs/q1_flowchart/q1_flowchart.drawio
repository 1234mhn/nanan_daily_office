<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="q1-flowchart" name="问题一解题思路">
    <mxGraphModel dx="900" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="问题一解题思路：质量评价与领域配比建模流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="24" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Node 1 -->
        <mxCell id="n1" value="① A1–A3 质量记录&#10;（272505 条 / 22 项指标）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="82" width="600" height="56" as="geometry"/>
        </mxCell>

        <!-- Node 2 -->
        <mxCell id="n2" value="② 指标方向统一与机制变换&#10;（logit差、softmax期望、ln(1+x)）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="158" width="600" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n2note" value="注：机制变换消除量纲与方向差异，使全部指标单调同向。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="227" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Node 3 -->
        <mxCell id="n3" value="③ Min-Max 归一化到 [0,1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="268" width="600" height="56" as="geometry"/>
        </mxCell>

        <!-- Node 4 -->
        <mxCell id="n4" value="④ 六语义组分组 → 组内取中位数&#10;（同组指标聚合成一个语义维度）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="344" width="600" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n4note" value="注：语义分组提升指标可解释性，中位数抑制组内极端值影响。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="413" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Node 5 (key) -->
        <mxCell id="n5" value="⑤ 组间熵权 → 文本质量分 S_s&#10;→ 领域质量分 S_d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="454" width="600" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n5note" value="注：熵权由数据离散度客观赋权，产出质量评价主指标 S_s 与 S_d。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="523" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Node 6 (key) -->
        <mxCell id="n6" value="⑥ 域内百分位秩极差 → 冲突标记&#10;（δ=0.9680，约10%）&#10;+ 加权中位数稳健秩评分 S_s*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="564" width="600" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n6note" value="注：极差阈值 δ 识别域内冲突样本，加权中位数秩评分给出稳健排序 S_s*。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="653" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Node 7 -->
        <mxCell id="n7" value="⑦ 领域配比模型&#10;和约束线性模型（基线）&#10;+ 二阶岭回归（预测）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="694" width="600" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n7note" value="注：和约束保证配比之和为 1，二阶岭回归抑制共线性、提升预测稳定性。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="783" width="650" height="20" as="geometry"/>
        </mxCell>

        <!-- Node 8 (key) -->
        <mxCell id="n8" value="⑧ 同尺度 1M 独立检验&#10;（R² 0.3215→0.5392）+ 配对 Bootstrap&#10;跨尺度 1B 诊断 R²=-8.6627&#10;→ 限定“参考配比邻域”适用边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#4A4A4A;strokeWidth=1.8;fontSize=15;fontColor=#000000;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="824" width="600" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="n8note" value="注：同尺度独立检验验证模型有效性；跨尺度诊断揭示尺度外推失效，故配比结论仅在“参考配比邻域”内适用。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#808080;fontFamily=Noto Sans CJK SC;" vertex="1" parent="1">
          <mxGeometry x="150" y="953" width="720" height="20" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#4A4A4A;strokeWidth=1.5;endSize=6;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>

