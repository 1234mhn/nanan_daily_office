/**
 * localStorage 统一封装层
 * 便于将来替换为 API 调用
 */

// 用户进度数据接口
export interface UserProgress {
  totalWords: number // 累计学习单词数
  totalStars: number // 总获得星星数
  currentLevel: number // 当前解锁关卡（1-based）
  levelProgress: Record<number, LevelProgress> // 每关进度
}

export interface LevelProgress {
  completed: boolean // 是否通关
  stars: number // 获得星星数 (0-3)
  progress: number // 进度百分比 (0-100)
  lastPlayed?: string // 最后游玩时间
}

const STORAGE_KEY = 'korean_app_user_progress'

/**
 * 获取用户进度
 */
export function getUserProgress(): UserProgress {
  if (typeof window === 'undefined') {
    return getDefaultProgress()
  }

  const stored = localStorage.getItem(STORAGE_KEY)
  if (!stored) {
    const defaultProgress = getDefaultProgress()
    saveUserProgress(defaultProgress)
    return defaultProgress
  }

  try {
    return JSON.parse(stored)
  } catch {
    return getDefaultProgress()
  }
}

/**
 * 保存用户进度
 */
export function saveUserProgress(progress: UserProgress): void {
  if (typeof window === 'undefined') return
  localStorage.setItem(STORAGE_KEY, JSON.stringify(progress))
}

/**
 * 默认进度：第一关已完成，第二关解锁
 */
function getDefaultProgress(): UserProgress {
  return {
    totalWords: 20,
    totalStars: 3,
    currentLevel: 2,
    levelProgress: {
      1: {
        completed: true,
        stars: 3,
        progress: 100,
        lastPlayed: new Date().toISOString(),
      },
      2: {
        completed: false,
        stars: 0,
        progress: 0,
      },
    },
  }
}

/**
 * 更新关卡进度
 */
export function updateLevelProgress(
  levelId: number,
  progress: Partial<LevelProgress>
): void {
  const userProgress = getUserProgress()
  userProgress.levelProgress[levelId] = {
    ...userProgress.levelProgress[levelId],
    ...progress,
  }
  saveUserProgress(userProgress)
}

/**
 * 重置所有进度（调试用）
 */
export function resetProgress(): void {
  if (typeof window === 'undefined') return
  localStorage.removeItem(STORAGE_KEY)
}
